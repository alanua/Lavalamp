[Unit]
Description=Skeleton Home Edge generative screensaver controller
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/skeleton/generative-saver.env
ExecStart=%h/.local/lib/lavalamp-home-edge/home_edge/screensaver/skeleton-generative-saver.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
